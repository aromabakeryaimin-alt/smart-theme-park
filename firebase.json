{
  "database": {
    "rules": "database.rules.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default"
    }
  ],
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/bootstrapAdmin",
        "function": {
          "functionId": "bootstrapAdmin",
          "region": "asia-southeast1"
        }
      }
    ]
  }
}
